{
  "name": "inkmind",
  "private": true,
  "version": "1.0.1",
  "description": "AI 长篇小说创作工作台（本地优先）",
  "author": "InkMind",
  "license": "AGPL-3.0-or-later",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite\"",
    "server": "tsx watch --watch-path ./server ./server/index.ts",
    "client": "vite",
    "start": "npm run build && node scripts/start-all.mjs",
    "once": "npm run build && node scripts/start-all.mjs",
    "build": "tsc -b && vite build",
    "build:exe": "npm run build && node scripts/build-exe.mjs",
    "electron:dev": "node scripts/build-electron.mjs && electron .",
    "electron:dist": "npm run build && node scripts/build-electron.mjs && electron-builder --win",
    "test": "vitest run",
    "lint": "oxlint",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
